<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" width="100%" height="100%">
  <defs>
    <!-- 背景グラデーション -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#020617"/>
      <stop offset="50%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e1b4b"/>
    </linearGradient>

    <!-- 1P/2P カラー対立グラデーション -->
    <linearGradient id="redGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f87171"/>
      <stop offset="100%" stop-color="#dc2626"/>
    </linearGradient>
    <linearGradient id="blueGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#60a5fa"/>
      <stop offset="100%" stop-color="#2563eb"/>
    </linearGradient>

    <!-- 爆弾ボディ -->
    <radialGradient id="appleBombBody" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#334155"/>
      <stop offset="50%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </radialGradient>
  </defs>

  <!-- 角丸背景 -->
  <rect width="180" height="180" fill="url(#bgGrad)"/>

  <!-- 対戦をイメージした赤青のバックライト -->
  <circle cx="50" cy="130" r="60" fill="url(#blueGlow)" opacity="0.25" filter="blur(20px)"/>
  <circle cx="130" cy="50" r="60" fill="url(#redGlow)" opacity="0.2" filter="blur(20px)"/>

  <!-- 枠線 -->
  <rect x="4" y="4" width="172" height="172" rx="36" fill="none" stroke="#334155" stroke-width="2" opacity="0.5"/>

  <!-- 火花アニメーション表現 -->
  <g transform="translate(130, 35)">
    <path d="M 0 -15 L 0 15 M -15 0 L 15 0 M -10 -10 L 10 10 M -10 10 L 10 -10" stroke="#fbbf24" stroke-width="4" stroke-linecap="round"/>
    <circle cx="0" cy="0" r="5" fill="#ef4444"/>
  </g>

  <!-- 導火線 -->
  <path d="M 90 75 C 90 45, 130 60, 130 35" fill="none" stroke="#d97706" stroke-width="8" stroke-linecap="round"/>

  <!-- 金口 -->
  <rect x="76" y="66" width="28" height="14" rx="4" fill="#64748b"/>

  <!-- 爆弾本体 -->
  <circle cx="90" cy="115" r="50" fill="url(#appleBombBody)" stroke="#1e293b" stroke-width="3"/>

  <!-- 光沢ハイライト -->
  <ellipse cx="72" cy="96" rx="12" ry="7" fill="#ffffff" opacity="0.2" transform="rotate(-30 72 96)"/>
  <circle cx="64" cy="88" r="4" fill="#ffffff" opacity="0.35"/>

  <!-- 中央のVS/クロスシンボル（交差する剣・炎モチーフ） -->
  <path d="M 78 115 L 102 115 M 90 103 L 90 127" stroke="#ef4444" stroke-width="8" stroke-linecap="round"/>
</svg>

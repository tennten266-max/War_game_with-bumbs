<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="100%" height="100%">
  <!-- 背景（ダークグラデーション） -->
  <rect width="64" height="64" rx="16" fill="#0f172a"/>
  <rect x="2" y="2" width="60" height="60" rx="14" fill="none" stroke="#334155" stroke-width="2"/>
  
  <!-- 導火線の火花 -->
  <path d="M 42 12 L 46 8 M 46 12 L 42 8 M 44 6 L 44 14 M 40 10 L 48 10" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round"/>
  <circle cx="44" cy="10" r="2" fill="#ef4444"/>

  <!-- 導火線 -->
  <path d="M 32 26 C 32 18, 44 22, 44 10" fill="none" stroke="#d97706" stroke-width="3.5" stroke-linecap="round"/>

  <!-- 爆弾本体（球体グラデーション） -->
  <defs>
    <radialGradient id="bombGrad" cx="35%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="60%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </radialGradient>
    <linearGradient id="fuseHead" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#94a3b8"/>
      <stop offset="100%" stop-color="#475569"/>
    </linearGradient>
  </defs>

  <!-- 爆弾の口（金口） -->
  <rect x="27" y="22" width="10" height="5" rx="1.5" fill="url(#fuseHead)"/>

  <!-- 爆弾本体 -->
  <circle cx="32" cy="40" r="18" fill="url(#bombGrad)" stroke="#1e293b" stroke-width="1.5"/>

  <!-- 爆弾の光沢（ハイライト） -->
  <circle cx="25" cy="33" r="4" fill="#ffffff" opacity="0.25"/>
  <circle cx="23" cy="31" r="1.5" fill="#ffffff" opacity="0.4"/>

  <!-- 導火線導火マーク / クロスカット線 -->
  <path d="M 28 42 L 32 46 L 38 36" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
